# Copie para .env e preencha SOMENTE com IDs reais das contas da unidade.
# Campos vazios = a tag correspondente não é carregada.

# Meta Pixel (ex.: 123456789012345)
VITE_META_PIXEL_ID=

# Google Analytics 4 (ex.: G-XXXXXXXXXX)
VITE_GA4_ID=

# Google Ads (ex.: AW-123456789) + rótulos das ações de conversão
VITE_GADS_ID=
VITE_GADS_LABEL_WHATSAPP=
VITE_GADS_LABEL_FORM=


